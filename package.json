{
  "name": "stock-discovery-v3",
  "version": "3.0.0",
  "description": "주식 종목 발굴 대시보드 Ver3 — 6축 횡단면 퍼센타일 스코어링(S/E 이원 점수) + HTS형 3패널 UI",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "node --env-file-if-exists=.env src/fetch_daily.js",
    "score": "node --env-file-if-exists=.env src/engine/discover.js",
    "backfill": "node --env-file-if-exists=.env src/engine/backfill.js",
    "notify": "node --env-file-if-exists=.env src/notify.js",
    "market": "node --env-file-if-exists=.env src/fetch_market.js",
    "news": "node --env-file-if-exists=.env src/fetch_news.js",
    "us": "node --env-file-if-exists=.env src/fetch_us.js",
    "score:us": "node --env-file-if-exists=.env src/engine/discover_us.js",
    "build": "node --env-file-if-exists=.env src/fetch_daily.js && node --env-file-if-exists=.env src/engine/discover.js",
    "serve": "node src/server.js",
    "dev": "node src/server.js"
  },
  "engines": {
    "node": ">=20.12"
  }
}
