# Supabase (감자마켓과 동일 패턴)
# 대시보드 Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...     # service_role 키 (배치 전용, 절대 프론트 노출 금지)
SUPABASE_ANON_KEY=eyJhbGci...        # 프론트(stock.html)용 공개 키

# 발굴 유니버스 필터
MIN_MARKET_CAP=50000000000           # 시총 하한 (기본 500억)
UNIVERSE_LIMIT=400                   # 히스토리 수집 종목 수 상한(시총순)
CONCURRENCY=4                        # 동시 수집 종목 수 (↑빠름/네이버 부하↑, 권장 3~6)
TOP_N=10                             # 발굴 TOP N

# 수집 모드: live | sample
#  live   = 네이버 실데이터 (시총순 유니버스 + 60일 시세)
#  sample = 더미 데이터 (UI 개발용, 인터넷·키 불필요)
FETCH_MODE=sample

# 텔레그램 알림 (선택) — 없으면 npm run notify 가 콘솔 미리보기만
#  봇 생성: @BotFather → /newbot → 토큰 / 챗ID: @userinfobot 또는 getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
